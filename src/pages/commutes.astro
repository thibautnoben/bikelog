---
import Layout from '../layouts/Layout.astro';
import ActivityList from '../components/ActivityList.astro';
import { listBikes, listCommutes, setReportEmail, type Activity } from '../lib/db';
import { formatKm } from '../lib/components';
import { formatHours, monthLabel } from '../lib/periods';
import { syncStrava } from '../lib/sync';
import { isEmailAddress } from '../lib/email';
import { sendCommuteReport } from '../lib/commuteReport';

const athlete = Astro.locals.athlete!;
let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const intent = form.get('intent');
  const email = String(form.get('report_email') ?? '').trim();
  if (intent === 'save_report' || intent === 'send_report') {
    if (email && !isEmailAddress(email)) {
      error = `“${email}” is not a valid e-mail address.`;
    } else if (email !== (athlete.report_email ?? '')) {
      await setReportEmail(athlete.id, email || null);
      athlete.report_email = email || null;
      notice = email ? `Monthly summary will be sent to ${email}.` : 'Monthly summary turned off.';
    }
  }
  if (!error && intent === 'send_report') {
    if (!athlete.report_email) {
      error = 'Enter an e-mail address first.';
    } else {
      try {
        const sent = await sendCommuteReport(athlete, new Date(), { origin: Astro.url.origin });
        notice = `Summary of ${sent} commute${sent === 1 ? '' : 's'} sent to ${athlete.report_email}.`;
      } catch (e) {
        console.error('Commute report failed:', e);
        error = `Could not send the summary: ${e instanceof Error ? e.message : e}`;
      }
    }
  }
}
try {
  await syncStrava(athlete, false, (p) => Astro.locals.cfContext.waitUntil(p));
} catch (e) {
  error = `Could not sync with Strava: ${e instanceof Error ? e.message : e}`;
}

const [commutes, bikes] = await Promise.all([listCommutes(athlete.id), listBikes(athlete.id)]);
const bikeNames = new Map(bikes.map((b) => [b.id, b.name]));

interface Month {
  key: string; // YYYY-MM, in the athlete's local time
  label: string;
  rides: Activity[];
  distance: number;
  time: number;
  byBike: Map<string, number>;
}
const months: Month[] = [];
for (const a of commutes) {
  const key = a.start_date_local.slice(0, 7);
  let m = months.at(-1);
  if (m?.key !== key) {
    months.push((m = { key, label: monthLabel(key, 'long'), rides: [], distance: 0, time: 0, byBike: new Map() }));
  }
  m.rides.push(a);
  m.distance += a.distance_m;
  m.time += a.moving_time_s;
  const bike = a.gear_id ? (bikeNames.get(a.gear_id) ?? 'Other gear') : 'No bike';
  m.byBike.set(bike, (m.byBike.get(bike) ?? 0) + a.distance_m);
}

const year = new Date().getUTCFullYear().toString();
const thisYear = commutes.filter((a) => a.start_date_local.startsWith(year));
const yearKm = thisYear.reduce((sum, a) => sum + a.distance_m, 0) / 1000;
const currentMonth = new Date().toISOString().slice(0, 7);
const rides = (n: number) => `${n} commute${n === 1 ? '' : 's'}`;
---

<Layout title="Commutes">
  <h1>Commutes</h1>
  {error && <p class="alert">{error}</p>}
  {notice && <p class="notice">{notice}</p>}
  <p class="muted">
    Rides marked as commute on Strava, per month.{' '}
    {thisYear.length > 0 && <>This year: <strong>{rides(thisYear.length)}</strong>, {formatKm(yearKm)}.</>}
    {commutes.length > 0 && <> <a href="/commutes/export" download>Export all as CSV</a></>}
  </p>

  <details class="card report" open={!!error || !!notice}>
    <summary>Monthly e-mail summary{athlete.report_email ? ` · ${athlete.report_email}` : ' · off'}</summary>
    <p class="muted small">
      On the 25th of every month, the commutes of the last 30 days are e-mailed to this address, with a CSV
      attached. Leave empty to turn it off.
    </p>
    <form method="post" class="report-form">
      <input
        type="email"
        name="report_email"
        value={athlete.report_email ?? ''}
        placeholder="you@example.com"
        autocomplete="email"
        aria-label="E-mail address"
      />
      <button name="intent" value="save_report">Save</button>
      <button class="secondary" name="intent" value="send_report">Send now</button>
    </form>
  </details>
  {
    !athlete.backfill_done && (
      <p class="muted small">Still importing older rides from Strava; earlier months will appear over the next syncs.</p>
    )
  }

  {
    months.length === 0 ? (
      <p class="card muted">
        No commutes yet. Mark rides as commute on Strava, or add a gear rule with “Mark as commute” on the{' '}
        <a href="/rules">Rules</a> page.
      </p>
    ) : (
      months.map((m) => (
        <details class="card month" open={m.key === currentMonth || m === months[0]}>
          <summary>
            <span class="month-name">{m.label}</span>
            <span class="month-stats">
              <strong>{rides(m.rides.length)}</strong> · {formatKm(m.distance / 1000)} · {formatHours(m.time)}
            </span>
          </summary>
          <p class="muted small by-bike">
            {m.byBike.size > 1 && <>{[...m.byBike].map(([name, d]) => `${name}: ${formatKm(d / 1000)}`).join(' · ')} · </>}
            <a href={`/commutes/export?month=${m.key}`} download>Export CSV</a>
          </p>
          <ActivityList activities={m.rides} bikeNames={bikeNames} />
        </details>
      ))
    )
  }
</Layout>

<style>
  .month {
    margin-bottom: 0.75rem;
  }
  .month > summary {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    align-items: baseline;
    color: var(--text);
    font-size: 1rem;
    list-style: none;
  }
  .month > summary::-webkit-details-marker {
    display: none;
  }
  .month > summary::before {
    content: '▸';
    color: var(--muted);
    margin-right: 0.4rem;
  }
  .month[open] > summary::before {
    content: '▾';
  }
  .month-name {
    font-weight: 700;
    font-size: 1.1rem;
    margin-right: auto;
  }
  .month-stats {
    color: var(--muted);
  }
  .month[open] > summary {
    margin-bottom: 0.5rem;
  }
  .by-bike {
    margin: 0 0 0.25rem;
  }
  .small {
    font-size: 0.85rem;
  }
  .notice {
    border: 1px solid var(--border);
    border-left: 3px solid var(--ok);
    border-radius: var(--radius-sm);
    background: var(--card);
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  .report {
    margin-bottom: 1rem;
  }
  .report > summary {
    color: var(--text);
  }
  .report-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .report-form input {
    flex: 1 1 14rem;
    min-width: 0;
  }
</style>
