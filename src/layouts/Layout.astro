---
import { Font } from 'astro:assets';

interface Props {
  title?: string;
  /** Summary for search results and link previews. */
  description?: string;
}
const {
  title,
  description = 'Track wear on your bike chains, tires, brake pads and other parts, with kilometres synced automatically from Strava.',
} = Astro.props;
const athlete = Astro.locals.athlete;
const syncedAt = athlete?.last_synced_at
  ? new Date(athlete.last_synced_at * 1000).toLocaleString('en-GB', {
      dateStyle: 'short',
      timeStyle: 'short',
      timeZone: 'Europe/Brussels',
    })
  : null;
const path = Astro.url.pathname;
/** Line icons for the phone tab bar (24×24, stroked in the current text colour). */
const TAB_ICONS = {
  bike: '<circle cx="5.2" cy="15.8" r="4.2"/><circle cx="18.8" cy="15.8" r="4.2"/><path d="M5.2 15.8H11L9.2 8.6zM9.2 8.6h7.4L11 15.8M16.6 8.6l2.2 7.2M7.4 7.4H11M16.6 8.6 16 6.4h2.4"/>',
  building: '<path d="M4 21V4.5a.5.5 0 0 1 .5-.5h9a.5.5 0 0 1 .5.5V21M14 9h5.5a.5.5 0 0 1 .5.5V21M2.5 21h19M7.5 8h3M7.5 12h3M7.5 16h3M17 13v.01M17 17v.01"/>',
  rules: '<path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>',
};
const tabs = [
  { href: '/', label: 'Bikes', icon: TAB_ICONS.bike, active: path === '/' || path.startsWith('/bikes/') },
  { href: '/commutes', label: 'Commutes', icon: TAB_ICONS.building, active: path.startsWith('/commutes') },
  { href: '/rules', label: 'Rules', icon: TAB_ICONS.rules, active: path.startsWith('/rules') },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title ? `${title} · Bikelog` : 'Bikelog'}</title>
    <meta name="description" content={description} />
    {/* Headings, the brand and buttons use it above the fold, so fetch it with the CSS rather than after. */}
    <Font cssVariable="--font-mono" preload />
    <link rel="icon" type="image/svg+xml" href="/icons/icon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#f0eee9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c0c0b" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Bikelog" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    {
      /* Chromium prefetches a same-origin page once a link is hovered or pressed, so the click renders
         without waiting for the server. Prefetch only: it never runs the page's scripts. Auth and webhook
         routes and rule previews (which call the Strava API) are skipped. Other browsers ignore this. */
    }
    <script type="speculationrules" is:inline>
      {
        "prefetch": [
          {
            "where": {
              "and": [
                { "href_matches": "/*" },
                { "not": { "href_matches": "/auth/*" } },
                { "not": { "href_matches": "/webhook/*" } },
                { "not": { "href_matches": "/*\\?*preview=*" } },
                { "not": { "selector_matches": "[rel~=nofollow], [download]" } }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body class:list={{ 'has-tabs': !!athlete }}>
    <header class="topbar">
      <a href="/" class="brand"><img src="/icons/icon.svg" alt="" width="28" height="28" /> Bikelog</a>
      {
        athlete && (
          <>
            <nav class="tabs" aria-label="Main">
              {tabs.map((t) => (
                <a href={t.href} aria-current={t.active ? 'page' : undefined}>
                  <svg
                    class="tab-icon"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                    set:html={t.icon}
                  />
                  {t.label}
                </a>
              ))}
            </nav>
            <div class="actions">
              {syncedAt && <span class="muted synced">Synced {syncedAt}</span>}
              <form method="post" action="/sync">
                <button type="submit" class="secondary" title={syncedAt ? `Last synced ${syncedAt}` : undefined}>
                  ↻ Sync
                </button>
              </form>
              <form method="post" action="/auth/logout">
                <button type="submit" class="link">Log out<span class="wide-only"> {athlete.firstname}</span></button>
              </form>
            </div>
          </>
        )
      }
    </header>
    <main>
      <slot />
    </main>
    <footer class="muted">
      Distances from <a href="https://www.strava.com" rel="noopener">Strava</a>.
    </footer>
    <script>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
      }
    </script>
  </body>
</html>

<style is:global>
  /* Look based on the Varsha theme (MIT, github.com/yethikrishna/web-ui-template). */
  :root {
    --bg: #f0eee9;
    --card: #f5f3ee;
    --text: #1a1a18;
    --text-soft: #3a3a36;
    --muted: #6b6b66;
    --border: #d8d6d0;
    --border-strong: #c4c2bb;
    /* Varsha's #4a9eff and status colours, darkened to reach AA contrast on the light background. */
    --accent: #1f66cc;
    --ok: #23803f;
    --soon: #8a6400;
    --due: #c73e3e;
    --on-level: #fff;
    --radius: 6px;
    --radius-sm: 4px;
    --mono: var(--font-mono);
    color-scheme: light dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #0c0c0b;
      --card: #131312;
      --text: #f0ece0;
      --text-soft: #dedad0;
      --muted: #8a8a80;
      --border: #252522;
      --border-strong: #2e2e2b;
      --accent: #4a9eff;
      --ok: #52c97a;
      --soon: #e6b84a;
      --due: #e05a5a;
      --on-level: #0c0c0b;
    }
  }
  * {
    box-sizing: border-box;
  }
  /* Author display rules (e.g. label { display: flex }) would otherwise override the hidden attribute. */
  [hidden] {
    display: none !important;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    line-height: 1.5;
    -webkit-font-smoothing: antialiased;
  }
  ::selection {
    background: color-mix(in srgb, var(--accent) 20%, transparent);
  }
  main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1rem 3rem;
  }
  a {
    color: inherit;
  }
  a:hover {
    color: var(--accent);
  }
  h1,
  h2,
  h3 {
    line-height: 1.2;
    font-family: var(--mono);
    letter-spacing: -0.03em;
  }
  h1 {
    font-weight: 400;
    letter-spacing: -0.04em;
  }
  h2 {
    font-weight: 500;
  }
  .topbar {
    display: flex;
    gap: 1rem;
    align-items: center;
    padding: 0.6rem 1rem;
    padding-top: max(0.6rem, env(safe-area-inset-top));
    padding-left: max(1rem, env(safe-area-inset-left));
    padding-right: max(1rem, env(safe-area-inset-right));
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 10;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--mono);
    font-weight: 700;
    letter-spacing: -0.04em;
    text-decoration: none;
    font-size: 1.1rem;
  }
  .tabs {
    display: flex;
    gap: 0.25rem;
    font-family: var(--mono);
    font-size: 0.9rem;
  }
  .tabs a {
    text-decoration: none;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--muted);
  }
  .tabs a[aria-current='page'] {
    color: var(--accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .tab-icon {
    display: none;
  }
  .actions {
    margin-left: auto;
    display: flex;
    gap: 0.75rem;
    align-items: center;
    font-size: 0.9rem;
  }
  footer {
    text-align: center;
    padding: 1rem;
    font-size: 0.85rem;
  }
  .muted {
    color: var(--muted);
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.25rem;
  }
  .card > h2:first-child {
    margin-top: 0;
  }
  .grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    align-items: start;
  }
  /* Varsha buttons: ink-coloured primary in mono type, turning accent on hover. */
  button,
  .button {
    font: inherit;
    font-family: var(--mono);
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    border-radius: var(--radius-sm);
    border: 1px solid var(--text);
    background: var(--text);
    color: var(--bg);
    padding: 0.4rem 0.9rem;
    text-decoration: none;
    display: inline-block;
    transition:
      color 0.12s ease,
      background 0.12s ease,
      border-color 0.12s ease;
  }
  button:hover:not(:disabled),
  .button:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--on-level);
  }
  button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }
  button.secondary {
    background: transparent;
    border-color: var(--border-strong);
    color: var(--text-soft);
  }
  button.secondary:hover:not(:disabled) {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    color: var(--accent);
  }
  button.link {
    background: none;
    border: none;
    color: var(--muted);
    padding: 0;
    font-family: inherit;
    font-weight: inherit;
    font-size: inherit;
    text-decoration: underline;
  }
  button.link:hover:not(:disabled) {
    background: none;
    color: var(--accent);
  }
  button.danger {
    background: transparent;
    border-color: var(--due);
    color: var(--due);
  }
  button.danger:hover:not(:disabled) {
    background: var(--due);
    border-color: var(--due);
    color: var(--on-level);
  }
  input,
  select,
  textarea {
    font: inherit;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    width: 100%;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .form-grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 180px), 1fr));
    align-items: end;
  }
  .inline-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    align-items: end;
  }
  .inline-form label {
    flex: 1 1 140px;
  }
  form {
    margin: 0;
  }
  .alert {
    border: 1px solid var(--border);
    border-left: 3px solid var(--due);
    border-radius: var(--radius-sm);
    background: var(--card);
    padding: 0.75rem 1rem;
    margin-bottom: 1rem;
  }
  .bar {
    height: 6px;
    border-radius: 3px;
    background: var(--border);
    overflow: hidden;
  }
  .bar > span {
    display: block;
    height: 100%;
  }
  .level-ok {
    --level: var(--ok);
  }
  .level-soon {
    --level: var(--soon);
  }
  .level-due {
    --level: var(--due);
  }
  .level-none {
    --level: var(--muted);
  }
  .bar > span {
    background: var(--level);
  }
  .badge {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 700;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    color: var(--on-level);
    background: var(--level);
    white-space: nowrap;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  th,
  td {
    text-align: left;
    padding: 0.4rem 0.5rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }
  th {
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--muted);
    text-transform: lowercase;
  }
  /* Wrapper for tables too wide for a phone: they scroll sideways instead of widening the page. */
  .table-scroll {
    overflow-x: auto;
  }
  .table-scroll table {
    min-width: 640px;
  }
  details > summary {
    cursor: pointer;
    color: var(--muted);
    font-size: 0.9rem;
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  input:focus,
  select:focus,
  textarea:focus {
    border-color: var(--accent);
  }
  /* Phones */
  @media (max-width: 640px) {
    main {
      padding: 1rem 0.75rem 2rem;
    }
    h1 {
      font-size: 1.5rem;
    }
    .card {
      padding: 0.85rem 1rem;
    }
    .synced,
    .wide-only {
      display: none;
    }
    /* A backdrop-filter would make the topbar the containing block of the fixed tab bar inside it. */
    .topbar {
      background: var(--bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }
    /* The tabs become an app-style bottom bar. */
    .tabs {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 10;
      background: var(--card);
      border-top: 1px solid var(--border);
      padding: 0.25rem 0.5rem max(0.25rem, env(safe-area-inset-bottom));
      gap: 0;
    }
    .tabs a {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      font-size: 0.75rem;
      padding: 0.3rem;
    }
    .tabs a[aria-current='page'] {
      background: none;
    }
    .tab-icon {
      display: block;
      width: 1.5rem;
      height: 1.5rem;
      margin-bottom: 0.1rem;
    }
    .tabs a[aria-current='page'] .tab-icon {
      stroke-width: 2;
    }
    body.has-tabs footer {
      padding-bottom: calc(4.5rem + env(safe-area-inset-bottom));
    }
  }

  /* Touch screens: 16px inputs stop iOS from zooming in, and bigger tap targets. */
  @media (pointer: coarse) {
    input,
    select,
    textarea {
      font-size: 16px;
      min-height: 44px;
    }
    button,
    .button {
      min-height: 44px;
    }
    button.link {
      min-height: 0;
      padding: 0.5rem;
    }
  }
</style>
