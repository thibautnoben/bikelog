---
import type { Activity } from '../lib/db';
import { formatHours } from '../lib/periods';

interface Props {
  activities: Activity[];
  /** Gear id → bike name; when given, a Bike column is shown. */
  bikeNames?: Map<string, string>;
}
const { activities, bikeNames } = Astro.props;

// start_date_local is the athlete's wall-clock time with a misleading 'Z' suffix, so format it as UTC.
const date = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
const km = (m: number) => `${(m / 1000).toFixed(1)} km`;
const bike = (gearId: string | null) => (gearId ? (bikeNames?.get(gearId) ?? 'Other gear') : '—');
---

<table class="activities">
  <thead>
    <tr>
      <th>Date</th>
      <th>Ride</th>
      {bikeNames && <th class="wide-col">Bike</th>}
      <th class="num">Distance</th>
      <th class="num wide-col">Time</th>
    </tr>
  </thead>
  <tbody>
    {
      activities.map((a) => (
        <tr>
          <td class="date">{date(a.start_date_local)}</td>
          <td class="name">
            <a href={`https://www.strava.com/activities/${a.id}`} target="_blank" rel="noopener">
              {a.name}
            </a>
            {a.device_watts ? <span title="Power meter"> ⚡</span> : null}
            {bikeNames && <div class="muted small narrow-only">{bike(a.gear_id)}</div>}
          </td>
          {bikeNames && <td class="wide-col">{bike(a.gear_id)}</td>}
          <td class="num">{km(a.distance_m)}</td>
          <td class="num wide-col">{formatHours(a.moving_time_s)}</td>
        </tr>
      ))
    }
  </tbody>
</table>

<style>
  .num {
    text-align: right;
    white-space: nowrap;
  }
  .date {
    white-space: nowrap;
    color: var(--muted);
  }
  .name a {
    text-decoration: none;
  }
  .name a:hover {
    text-decoration: underline;
  }
  .small {
    font-size: 0.8rem;
  }
  .narrow-only {
    display: none;
  }
  @media (max-width: 640px) {
    .wide-col {
      display: none;
    }
    .narrow-only {
      display: block;
    }
  }
</style>
